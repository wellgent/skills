#!/usr/bin/env bash
# usage
# Prints this host's Claude subscription usage as JSON, read from the OAuth usage endpoint with
# the login Claude Code stores on the host, so no model call is made:
#   {"seven_day": {"percent": 42, "resets_at": "<ISO time>"}, "five_hour": {"percent": 7, "resets_at": "<ISO time>"}}
# The token comes from CLAUDE_CODE_OAUTH_TOKEN, the macOS keychain, the credentials file under
# ${CLAUDE_CONFIG_DIR:-~/.claude}, or the Linux secret service, in that order.
# Exit 0 read, 2 unreadable (no login on the host, the endpoint refused or did not answer), 1 a missing tool.
set -euo pipefail
die() { echo "usage: $*" >&2; exit "${USAGE_EXIT:-1}"; }
for tool in curl jq; do command -v "$tool" >/dev/null 2>&1 || die "$tool is not on PATH"; done

from_blob() { jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null || true; }
token=${CLAUDE_CODE_OAUTH_TOKEN:-}
if [ -z "$token" ] && command -v security >/dev/null 2>&1; then
  token=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null | from_blob) || true
fi
creds="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
if [ -z "$token" ] && [ -f "$creds" ]; then
  token=$(from_blob <"$creds")
fi
if [ -z "$token" ] && command -v secret-tool >/dev/null 2>&1; then
  token=$(secret-tool lookup service "Claude Code-credentials" 2>/dev/null | from_blob) || true
fi
[ -n "$token" ] || USAGE_EXIT=2 die "no Claude login found on this host"

# The token goes to curl on stdin, so it never shows in the process list.
response=$(printf 'header = "Authorization: Bearer %s"\n' "$token" |
  curl -sS --max-time 15 --config - \
    -H "Accept: application/json" \
    -H "anthropic-beta: oauth-2025-04-20" \
    https://api.anthropic.com/api/oauth/usage 2>&1) ||
  USAGE_EXIT=2 die "the usage endpoint did not answer: $(head -c 200 <<<"$response")"
jq -e '.seven_day.utilization | numbers' >/dev/null 2>&1 <<<"$response" ||
  USAGE_EXIT=2 die "the usage endpoint returned no weekly usage: $(tr -s " \n" " " <<<"$response" | head -c 300)"
jq -c '{seven_day: {percent: .seven_day.utilization, resets_at: .seven_day.resets_at},
        five_hour: {percent: .five_hour.utilization?, resets_at: .five_hour.resets_at?}}' <<<"$response"
