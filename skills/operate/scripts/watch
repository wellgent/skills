#!/usr/bin/env bash
# watch <request issue> [<after comment URL or id>]
# Run from the brain's checkout. Waits on the run request and the run's Rex session, and returns
# with one reason, so the operator session that started it in the background acts on it:
#   exit 0  new comments after the given one (default: the newest one now), printed in full once the
#           newest is WATCH_SETTLE_SECONDS old (default 90), so a follow-up posted right after a stop
#           arrives with it; the operator's own (opening with **Operator or scope: **Operator) are skipped
#   exit 3  the run's session is gone or its agent has exited, with no new comment
#   exit 4  this host's weekly usage is at or above WATCH_WEEKLY_LIMIT percent (default 90; off disables)
#   exit 5  the run's session has had no status change for WATCH_IDLE_MINUTES (default 30), or for
#           WATCH_STALL_MINUTES (default 60) while it reads working, with no new comment and nobody
#           assigned on the request (an assignee is the requester holding a call the run waits on, so
#           its quiet is expected)
#   exit 6  the weekly usage has been unreadable for WATCH_USAGE_BLIND_MINUTES (default 30)
#   exit 7  a permission prompt in the run's session, its main agent's or a subagent's, has held for
#           WATCH_PERMISSION_SECONDS (default 60), with no new comment
#   exit 1  a usage error
# Exits 3 to 7 print a one-line reason. A failed GitHub call or usage read while waiting is retried.
set -euo pipefail
die() { echo "watch: $*" >&2; exit 1; }
for tool in gh jq rex; do command -v "$tool" >/dev/null 2>&1 || die "$tool is not on PATH"; done
here=$(cd "$(dirname "$0")" && pwd)

issue=${1:?usage: watch <request issue> [<after comment URL or id>]}
issue=${issue##*/}
case $issue in *[!0-9]*|"") die "issue must be a number or an issue URL, got: $1" ;; esac
interval=${WATCH_INTERVAL:-60}
weekly_limit=${WATCH_WEEKLY_LIMIT:-90}
settle_s=${WATCH_SETTLE_SECONDS:-90}
usage_every=${WATCH_USAGE_INTERVAL:-300}
idle_s=$(( ${WATCH_IDLE_MINUTES:-30} * 60 ))
stall_s=$(( ${WATCH_STALL_MINUTES:-60} * 60 ))
blind_s=$(( ${WATCH_USAGE_BLIND_MINUTES:-30} * 60 ))
permission_s=${WATCH_PERMISSION_SECONDS:-60}
case $weekly_limit in off|[0-9]|[0-9][0-9]|100) ;; *) die "WATCH_WEEKLY_LIMIT must be a percent or off, got: $weekly_limit" ;; esac

comments() { gh issue view "$issue" --json comments --jq '[.comments[] | {id: (.url | sub(".*issuecomment-"; "") | tonumber), author: .author.login, at: .createdAt, url, body}]'; }
# The id is the number in the comment's URL (issuecomment-<n>), never GraphQL's node id (IC_...).
after=${2:-$(comments | jq 'map(.id) | max // 0')}
after=${after##*issuecomment-}
case $after in *[!0-9]*|"") die "the comment must be its URL or the number in it, got: $2" ;; esac

# The session name follows start: op-<repo>-<issue>.
repo=$(gh issue view "$issue" --json body --jq '.body' | sed -n 's/^- \*\*Repo:\*\* *\([^ ]*\).*/\1/p' | head -1)
[ -n "$repo" ] || die "request $issue names no repo"
session="op-${repo##*/}-$issue"

# Rex streams the session's events, so the quiet clock counts from the run's last status change. Each
# round still reads the status, since the stream stays open after a session is killed.
changed_at=$(date +%s)
follow() { exec 3< <(exec rex events -s "$session" --json 2>/dev/null); events_pid=$!; }
trap 'kill "$events_pid" 2>/dev/null || true' EXIT
follow
# Waits out one round, and returns early when the agent exits.
await_round() {
  local until=$(($(date +%s) + interval)) left line
  while left=$((until - $(date +%s))); [ "$left" -gt 0 ]; do
    if IFS= read -r -t "$left" -u 3 line; then
      case $line in
        *'"name":"child_exited"'*) changed_at=$(date +%s); return ;;
        *'"name":"program_status_changed"'*|*'"name":"process_changed"'*) changed_at=$(date +%s) ;;
      esac
    elif [ $? -gt 128 ]; then return
    else follow; sleep "$left"; return
    fi
  done
}

usage_at=0
permission_at=0
# The start of an unreadable streak lives in a host file, so a watch restarted after each comment
# keeps counting the streak instead of starting it again.
blind_file="${XDG_STATE_HOME:-$HOME/.local/state}/operate/usage-unreadable-since"

while :; do
  # A failed GitHub call (a 5xx, a dropped connection) is retried on the next round.
  if all=$(comments 2>/dev/null); then
    # The operator's own comments open with **Operator, or scope: **Operator, and never need its answer.
    new=$(jq --argjson after "$after" '[.[] | select(.id > $after and (.body | test("^(scope: )?\\*\\*Operator") | not))]' <<<"$all")
    if [ "$(jq length <<<"$new")" -gt 0 ]; then
      # A run can post a stop and then amend it; wait until the newest has been quiet for the settle time.
      age=$(jq 'now - (map(.at | fromdateiso8601) | max) | floor' <<<"$new")
      if [ "$age" -lt "$settle_s" ]; then sleep $((settle_s - age)); continue; fi
      jq -r '.[] | "=== comment \(.id) by \(.author) at \(.at) \(.url)\n\(.body)\n"' <<<"$new"
      exit 0
    fi
  fi

  rc=0
  status=$(rex block call -s "$session" -b agent program_status 2>/dev/null) || rc=$?
  if [ "$rc" -eq 3 ]; then
    echo "watch: $session is gone and request $issue has no comment after $after" >&2
    exit 3
  fi
  if [ "$rc" -eq 0 ] && [ "$(rex block call -s "$session" -b agent process 2>/dev/null | jq '.last_exit != null')" = true ]; then
    echo "watch: the agent in $session has exited and request $issue has no comment after $after" >&2
    exit 3
  fi
  now=$(date +%s)
  # The operator assigns the requester while a call is theirs: the run waits on it, so quiet is not idle.
  assigned=$(gh issue view "$issue" --json assignees --jq '.assignees | length' 2>/dev/null || echo 0)
  [ "${assigned:-0}" -eq 0 ] || changed_at=$now
  # Any record working means the run is, since a background agent reports below a settled root.
  state=$(jq -r 'if any(.records[]?; .state == "working") then "working" else (.records[0].state // "unknown") end' <<<"$status" 2>/dev/null || echo unknown)
  # A prompt holds its agent while the other records keep the run reading working, so it has its own clock.
  if [ "$rc" -eq 0 ] && jq -e 'any(.records[]?; .state == "blocked" and .kind == "permission")' >/dev/null 2>&1 <<<"$status"; then
    [ "$permission_at" -ne 0 ] || permission_at=$now
    if [ $((now - permission_at)) -ge "$permission_s" ]; then
      echo "watch: $session has held a permission prompt for $((now - permission_at)) seconds and request $issue has no comment after $after" >&2
      exit 7
    fi
  else
    permission_at=0
  fi
  limit=$idle_s
  [ "$state" != working ] || limit=$stall_s
  if [ "$rc" -eq 0 ] && [ $((now - changed_at)) -ge "$limit" ]; then
    echo "watch: $session has been $state with no status change for $(( (now - changed_at) / 60 )) minutes and request $issue has no comment after $after" >&2
    exit 5
  fi

  if [ "$weekly_limit" != off ] && [ $((now - usage_at)) -ge "$usage_every" ]; then
    usage_at=$now
    if usage=$(bash "$here/usage" 2>&1); then
      rm -f "$blind_file"
      weekly=$(jq -r '.seven_day.percent' <<<"$usage")
      if jq -e --argjson limit "$weekly_limit" '.seven_day.percent >= $limit' >/dev/null <<<"$usage"; then
        echo "watch: weekly usage on $(hostname -s) is at ${weekly}% (limit ${weekly_limit}%), resets at $(jq -r '.seven_day.resets_at' <<<"$usage")" >&2
        exit 4
      fi
    else
      # A file no watch has touched for two usage rounds is an earlier streak, not this one.
      if [ -n "$(find "$blind_file" -mmin "+$((usage_every / 30))" 2>/dev/null)" ]; then
        rm -f "$blind_file"
      fi
      since=$(cat "$blind_file" 2>/dev/null || true)
      case $since in ''|*[!0-9]*)
        # Said once per failing streak; the read is retried on the next usage round.
        since=$now
        mkdir -p "${blind_file%/*}" && echo "$since" >"$blind_file"
        echo "watch: weekly usage unreadable, retrying: $usage" >&2 ;;
      esac
      touch "$blind_file"
      if [ $((now - since)) -ge "$blind_s" ]; then
        # The operator reads the pane now, and the next exit 6 comes a full window later.
        echo "$now" >"$blind_file"
        echo "watch: weekly usage on $(hostname -s) unreadable for $(( (now - since) / 60 )) minutes: $usage" >&2
        exit 6
      fi
    fi
  fi
  await_round
done
