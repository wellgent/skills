#!/usr/bin/env bash
# start <owner>/<repo> <issue> <prompt file>
# Starts one pstack run as its own Rex session in the project's checkout at ~/repos/<repo>: the
# session op-<repo>-<issue>, Claude Code in its block labelled agent, /pstack:poteto-mode pointed
# at the prompt file as the start prompt. Prints the session name.
# Exit 0 started, 4 stopped at a startup prompt to answer in the block, 1 failed.
set -euo pipefail
die() { echo "start: $*" >&2; exit 1; }
for tool in rex jq claude; do command -v "$tool" >/dev/null 2>&1 || die "$tool is not on PATH"; done

repo=${1:?usage: start <owner>/<repo> <issue> <prompt file>}
issue=${2:?usage: start <owner>/<repo> <issue> <prompt file>}
prompt_file=${3:?usage: start <owner>/<repo> <issue> <prompt file>}
case $repo in */*) ;; *) die "repo must be <owner>/<repo>, got: $repo" ;; esac
case $issue in *[!0-9]*|"") die "issue must be a number, got: $issue" ;; esac
name=${repo##*/}
cwd="$HOME/repos/$name"
[ -d "$cwd/.git" ] || die "no checkout at $cwd"
[ -f "$prompt_file" ] || die "no prompt file at $prompt_file"

# Rex allows two sessions with one label, and then neither can be named.
session="op-$name-$issue"
if rex session inspect "$session" --json >/dev/null 2>&1; then die "session $session already exists"; fi

prompt="/pstack:poteto-mode The run request is in $prompt_file: read it and run it as written, including its run lines."
# --keep-open leaves the last screen readable after Claude Code exits.
out=$(rex new "$session" -c "$cwd" --keep-open --json -- claude --permission-mode bypassPermissions -n "$session" "$prompt") ||
  die "could not create session $session"
block=$(jq -er '.initial_windows[0].block_ids[0]' <<<"$out") || die "no block in: $out"
rex block rename -s "$session" "$block" agent >/dev/null

# Claude Code reports its first status once it is past folder trust and login, which report nothing.
waited=0
while [ "$waited" -lt "${START_WAIT_SECONDS:-120}" ]; do
  if [ "$(rex block call -s "$session" -b agent process | jq '.last_exit != null')" = true ]; then
    die "claude exited in $session: $(rex capture -s "$session" -b agent --trim | tail -n 5)"
  fi
  if [ "$(rex block call -s "$session" -b agent program_status | jq '.records | length')" -gt 0 ]; then
    echo "$session started"
    exit 0
  fi
  sleep 2; waited=$((waited + 2))
done
echo "$session stopped at a startup prompt: answer it in the block (rex capture -s $session -b agent --trim)"
exit 4
