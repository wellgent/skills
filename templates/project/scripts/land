#!/usr/bin/env bash
# Lands one PR: squash-merges it onto main only when its exact head SHA carries a passing `check`
# status from scripts/check, under --match-head-commit, then reads the merge back from origin.
# A failed `gh pr merge` still lands when the PR reads back merged on that head.
# The PR need not be up to date with main. On a project with scripts/production-live, the merge
# waits until production runs main's tip, so two production deploys never overlap; after
# LAND_DEPLOY_WAIT_S (default 1800) it gives up, which is a stop: never deploy production by hand.
# Exit: 0 merged, 1 refused (not open, base not main, head moved, merge failed), 3 no passing
# `check` on the head, 4 production not on main's tip in time.
set -euo pipefail

[ $# -eq 1 ] && [[ $1 =~ ^[0-9]+$ ]] || { echo "usage: scripts/land <pr number>" >&2; exit 1; }
pr=$1

cd "$(git rev-parse --show-toplevel)"
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)

read -r head base state < <(gh pr view "$pr" --repo "$repo" --json headRefOid,baseRefName,state \
  --jq '[.headRefOid, .baseRefName, .state] | @tsv')
[ "$state" = OPEN ] || { echo "land: PR $pr is $state, not open" >&2; exit 1; }
[ "$base" = main ] || { echo "land: PR $pr targets $base, not main" >&2; exit 1; }

check=$(gh api "repos/$repo/commits/$head/status" \
  --jq '[.statuses[] | select(.context == "check")][0].state // "none"')
[ "$check" = success ] || { echo "land: PR $pr head $head has no passing check status ($check); run scripts/check on it" >&2; exit 3; }

if [ -x scripts/production-live ]; then
  wait_s=${LAND_DEPLOY_WAIT_S:-1800}
  poll_s=${LAND_DEPLOY_POLL_S:-15}
  [ "$poll_s" -ge 1 ] || poll_s=1
  waited=0
  while :; do
    git fetch -q origin main
    tip=$(git rev-parse origin/main)
    live=$(scripts/production-live 2>&1) && [ "$live" = "$tip" ] && break
    if [ "$waited" -ge "$wait_s" ]; then
      echo "land: production runs ${live:-nothing readable}, not main's tip $tip, after $((waited / 60)) min; PR $pr is not merged. This is a stop: never deploy production by hand" >&2
      exit 4
    fi
    [ "$waited" -gt 0 ] || echo "land: waiting for production to run main's tip $tip"
    sleep "$poll_s"
    waited=$((waited + poll_s))
  done
fi

if ! gh pr merge "$pr" --repo "$repo" --squash --match-head-commit "$head"; then
  read -r state merged_head < <(gh pr view "$pr" --repo "$repo" --json state,headRefOid \
    --jq '[.state, .headRefOid] | @tsv') || true
  [ "$state" = MERGED ] && [ "$merged_head" = "$head" ] \
    || { echo "land: merging PR $pr failed (a moved head refuses)" >&2; exit 1; }
fi

merged=""
for _ in $(seq 1 10); do
  read -r state base merged < <(gh pr view "$pr" --repo "$repo" --json state,baseRefName,mergeCommit \
    --jq '[.state, .baseRefName, (.mergeCommit.oid // "")] | @tsv')
  [ "$state" = MERGED ] && [ -n "$merged" ] && break
  sleep 2
done
[ "$state" = MERGED ] && [ "$base" = main ] || { echo "land: PR $pr reads back $state on $base" >&2; exit 1; }
git fetch -q origin main
git merge-base --is-ancestor "$merged" origin/main \
  || { echo "land: merge commit $merged is not on origin/main" >&2; exit 1; }
echo "land: PR $pr merged as $merged on origin/main (head $head)"
