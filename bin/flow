#!/usr/bin/env bash
# flow: the mechanical parts of the development flow (see FLOW.md).
set -euo pipefail

src=${BASH_SOURCE[0]}
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
FLOW_BIN=$(cd -P "$(dirname "$src")" && pwd)
export FLOW_BIN
export FLOW_HOME=${FLOW_HOME:-$(dirname "$FLOW_BIN")}

usage() {
  cat <<'USAGE'
Usage: flow <command> [args]

Lead commands:
  spawn <step> <target> [--cwd <dir>] [--lead <agent>] [--note <text>]
        [--model <id>] [--effort <level>] [--wait]
        Start a step as its own herdr session and return at once; the start reports
        to the lead's pane as spawn: <step> <target> <run> started|blocked|failed.
        <target> is <owner>/<repo>#<issue> for a spec, ticket or batch, or
        <owner>/<repo> for an audit or retro step. --model and --effort override the
        flow config for this run. --wait starts in the foreground: exit 0 started,
        4 blocked at a startup prompt, 1 failed.
  gate <target> [--accept <reason>] [--wait] [--lead <agent>]
        Run the check command, the journey tests and the protected-change script on
        the branch checked out in the current directory, print the diff class, and
        return at once; the result reaches the lead's pane as
        gate: <target> <verdict> <diff class> <result path>.
        --accept records the reason against the open flags of the result on HEAD
        and runs nothing. --wait runs in the foreground: exit 0 pass, 1 red, 2 flagged.
  land <target> [--lead <agent>] [--wait]
        Fast-forward the main branch to the gated commit and push, then run the
        scanner pass and append the health check row, reported to the lead's pane as
        health: <target> <commit> appended|failed|skipped.
        Exit 3 when the main branch moved and the gate must run again.
  tick arm|disarm|run [<lead>]
        Manage or run the crontab entry that every 30 minutes reports stalled
        sessions and new request comments to the lead, then nudges it.
  protected <base> <head>
        Print the protected-change flags for a diff as JSON.
  ledger <command> ...
        Append rows to the project's ledger, fill costs, roll it up over the Retro window.
        flow ledger help lists the commands.
  status <owner>/<repo>
        The read-only status view: the open iteration or batches, each target in flight
        with its stage and live session, sessions at a limit or waiting, open requests
        with their age, and the ledgered cost. Runs in any shell on a run host.
  cost <session id> [--harness claude|codex] [--from <time>] [--to <time>]
        Print a session's tokens and list-price cost from its transcript as JSON.
  sources [seen <name> [<version>] | seen --unchanged | pin <name>]
        Compare every source in the source log with its upstream, or record a review.
  ready [<owner>/<repo>]
        The propagation check: is the flow repo, the brain, the host and the project
        current? Exit 0 when nothing is behind, 1 otherwise.
  trust [--check] <dir>
        Mark a checkout as trusted in both harnesses on this host.

Session commands (inside a spawned step):
  report <outcome> [<artifact link>]
        Send the run-end report to the lead.
  ask [--conflict] <question>
        Send a question or a conflict exit to the lead, then wait for its reply
        in this session.

Steps: ux-design system-design system-design-second grooming build review qa
       audit audit-second audit-architecture retro
USAGE
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  spawn|gate|land|tick|protected|report|cost|ledger|status|sources|ready|trust) exec "$FLOW_BIN/flow-$cmd" "$@" ;;
  ask) exec "$FLOW_BIN/flow-report" --ask "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 64 ;;
esac
