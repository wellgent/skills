#!/usr/bin/env bash
# flow land <target> [--lead <agent>] [--wait]
# Runs on the branch checked out in the current directory.
# Needs a passed gate on HEAD. Rebases onto the main branch when it moved or the branch
# holds merge commits; the gate still holds when the rebased tree is the gated tree.
# Then fast-forwards the remote main branch to HEAD and appends the health check row: the
# scanner pass docs/agents/dev-loop.md declares, run on the landed commit, detached, reported
# to the lead's pane as
#   health: <target> <commit> appended|failed|skipped ...
# --wait runs the scanner pass in the foreground.
# Exit 3 when the rebase changed the tree and flow gate must run again.
set -euo pipefail
. "$FLOW_BIN/lib.sh"
need git jq

target= lead=$(lead_agent) wait= deliver= health_commit=
while [ $# -gt 0 ]; do
  case $1 in
    --lead) lead=${2:?--lead needs a herdr agent}; shift 2 ;;
    --wait) wait=1; shift ;;
    --deliver) deliver=1; shift ;;
    --health) health_commit=${2:?}; shift 2 ;;
    -*) die "unknown option: $1" ;;
    *) [ -z "$target" ] || die "unexpected argument: $1"; target=$1; shift ;;
  esac
done
[ -n "$target" ] || die "usage: flow land <target> [--lead <agent>] [--wait]"
parse_target "$target"

git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
cd "$(git rev-parse --show-toplevel)"
config=$(find_config)

# The health check: one number per measure from the scanner pass lines of docs/agents/dev-loop.md,
#   - `<measure>`, `<measure>`: `<command>`, `<command>`
# one command per measure, in the same order, each printing its number as the last line of stdout.
health_check() {
  local commit=$1 report plan line left right measures commands m c out value code pairs=()
  report="health: $target ${commit:0:12}"
  plan="$(gate_dir)/$commit.health.plan"
  dev_loop_section "Scanner pass" >"$plan.lines"
  if [ ! -s "$plan.lines" ]; then
    rm -f "$plan.lines"
    echo "$report skipped: docs/agents/dev-loop.md has no scanner pass"; return 0
  fi
  : >"$plan"
  while IFS= read -r line; do
    left=${line%%'`: '*}
    [ "$left" != "$line" ] || continue
    right=${line#"$left"'`: '}
    measures=$(grep -o '`[^`]*`' <<<"$left\`" | sed 's/^`//; s/`$//')
    commands=$(grep -o '`[^`]*`' <<<"$right" | sed 's/^`//; s/`$//')
    if [ "$(wc -l <<<"$measures")" -ne "$(wc -l <<<"$commands")" ]; then
      echo "$report failed: the scanner line for $(tr '\n' ' ' <<<"$measures")names $(wc -l <<<"$commands" | tr -d ' ') commands for $(wc -l <<<"$measures" | tr -d ' ') measures"
      return 1
    fi
    paste -d $'\t' <(echo "$measures") <(echo "$commands") >>"$plan"
  done <"$plan.lines"
  rm -f "$plan.lines"
  while IFS=$'\t' read -r m c; do
    echo "flow land: health check: $m: $c" >&2
    code=0
    out=$(bash -c "$c" 2>"$(gate_dir)/$commit.health.$m.log") || code=$?
    value=$(grep -v '^[[:space:]]*$' <<<"$out" | tail -n 1 | tr -d '[:space:]')
    if [ "$code" -ne 0 ] || ! [[ $value =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
      echo "$report failed: $m gave '${value:-nothing}' (exit $code): $(tail -n 3 "$(gate_dir)/$commit.health.$m.log" | tr '\n' ' ')"
      return 1
    fi
    pairs+=("$m=$value")
  done <"$plan"
  if out=$("$FLOW_BIN/flow-ledger" health "$TARGET_REPO" --commit "$commit" "${pairs[@]}" 2>&1); then
    echo "$report appended ${#pairs[@]} measures: ${pairs[*]}"
  else
    echo "$report failed: $(tail -n 3 <<<"$out" | tr '\n' ' ')"; return 1
  fi
}

# The detached half.
if [ -n "$health_commit" ]; then
  line=$(health_check "$health_commit") || true
  echo "$line"
  [ -z "$deliver" ] || tell_lead "$lead" "$line"
  exit 0
fi

require_clean_tree
main=$(main_branch)
branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" != "$main" ] || die "check out the branch to land, not $main"
git fetch --quiet origin "$main"

dir=$(gate_dir)
gated=$(git rev-parse HEAD)
marker="$dir/$gated.json"
[ -f "$marker" ] || die "no gate result for ${gated:0:12}; run flow gate first"
[ "$(jq -r .verdict "$marker")" = pass ] || die "the gate on ${gated:0:12} is $(jq -r .verdict "$marker"), not pass"
gated_tree=$(jq -r .tree "$marker")
[ -n "$wait" ] || [ -n "$lead" ] || die "no lead to deliver the health check to: run inside the lead's herdr session, pass --lead <agent>, or --wait"

if ! git merge-base --is-ancestor "origin/$main" HEAD ||
   [ -n "$(git rev-list --merges "origin/$main..HEAD")" ]; then
  echo "flow land: rebasing $branch onto origin/$main" >&2
  if ! git rebase --quiet "origin/$main" >&2; then
    git rebase --abort
    FLOW_EXIT=3 die "rebase onto origin/$main conflicts; resolve it in Build, then run flow gate again"
  fi
  if [ "$(git rev-parse 'HEAD^{tree}')" != "$gated_tree" ]; then
    FLOW_EXIT=3 die "$main moved, so the rebased tree differs from the gated one; run flow gate again"
  fi
  # Same tree, new commit: the gate result carries over.
  jq --arg commit "$(git rev-parse HEAD)" --arg from "$gated" '.commit = $commit | .rebased_from = $from' \
    "$marker" >"$dir/$(git rev-parse HEAD).json"
fi

commit=$(git rev-parse HEAD)
git push --quiet origin "$commit:refs/heads/$main"
git fetch --quiet origin "$main"

# Bring the local main branch along where that is safe.
main_worktree=$(git worktree list --porcelain | awk -v ref="refs/heads/$main" '/^worktree /{w=substr($0,10)} $0=="branch " ref{print w}')
if [ -n "$main_worktree" ]; then
  if [ -z "$(git -C "$main_worktree" status --porcelain)" ]; then
    git -C "$main_worktree" merge --quiet --ff-only "origin/$main"
  else
    echo "flow land: $main_worktree is dirty, local $main left behind origin/$main" >&2
  fi
elif git show-ref --verify --quiet "refs/heads/$main" && git merge-base --is-ancestor "refs/heads/$main" "$commit"; then
  git update-ref "refs/heads/$main" "$commit"
fi

jq -n --arg target "$target" --arg commit "$commit" --arg gated "$gated" --arg branch "$branch" \
  --arg main "$main" --arg time "$(now_utc)" \
  '{target: $target, landed: $commit, gated: $gated, branch: $branch, main: $main, time: $time}'
echo "flow land: $main is at ${commit:0:12}" >&2

if [ -n "$wait" ]; then
  health_check "$commit" >&2 || true
else
  need herdr
  export FLOW_CONFIG=$config
  detach "$dir/$commit.health.log" "$FLOW_BIN/flow-land" "$target" --health "$commit" --deliver --lead "$lead"
  echo "flow land: the health check runs in the background; its row arrives in $lead as health: $target ${commit:0:12} ..." >&2
fi
