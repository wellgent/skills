#!/usr/bin/env bash
# flow tick arm [<lead>]     add the crontab entry that runs every 30 minutes for the lead session
# flow tick disarm [<lead>]  remove it
# flow tick run <lead>       what the entry runs, silent when the lead session does not exist:
#   - a spawned session at a usage limit is asked to continue; one stalled there for 30 minutes
#     is reported as `limit: <run> stalled <minutes> ...` with the spawn command that respawns
#     the step on the flow config's fallback model at the same effort
#   - the lead session stalled at a usage limit for 30 minutes is switched to the fallback model
#     (Claude Code takes /model; a Codex lead is asked to continue) and asked to continue
#   - an open request issue (label lead:round on the flow config's tracker) with a comment since
#     the last tick is reported as `request: <url> ...`
#   - then `lead tick: check runs` nudges the lead
# The tick catches what cannot report: a permission prompt, a crash, a usage limit, a session
# that never started, an answer on the tracker. The lead arms it at its first spawn and disarms
# it at close.
set -euo pipefail
. "$FLOW_BIN/lib.sh"

action=${1:-}
lead=${2:-$(lead_agent)}
tag="# flow-tick $lead"
LIMIT='(usage limit|rate limit reached|limit reached|hit your limit)'
STALL_MINUTES=30

case $action in
  arm)
    need herdr jq crontab gh
    [ -n "$lead" ] || die "no lead: run inside the lead's herdr session, or pass the agent"
    config=$(find_config)
    path=$(dirname "$(command -v herdr)")
    for tool in jq gh; do
      case ":$path:" in *":$(dirname "$(command -v "$tool")"):"*) ;; *) path="$path:$(dirname "$(command -v "$tool")")" ;; esac
    done
    path="$path:/usr/local/bin:/usr/bin:/bin"
    mkdir -p "$(state_dir)/ticks"
    entry="*/30 * * * * PATH=$path FLOW_CONFIG=$config"
    [ -z "${HERDR_SOCKET_PATH:-}" ] || entry="$entry HERDR_SOCKET_PATH=$HERDR_SOCKET_PATH"
    entry="$entry $FLOW_BIN/flow tick run '$lead' >$(state_dir)/ticks/$lead.log 2>&1 $tag"
    { crontab -l 2>/dev/null | grep -vF -- "$tag" || true; echo "$entry"; } | crontab -
    echo "armed: $entry"
    ;;
  disarm)
    need crontab
    [ -n "$lead" ] || die "no lead: run inside the lead's herdr session, or pass the agent"
    rest=$(crontab -l 2>/dev/null | grep -vF -- "$tag" || true)
    if [ -n "$rest" ]; then echo "$rest" | crontab -; else crontab -r 2>/dev/null || true; fi
    echo "disarmed: $lead"
    ;;
  run)
    need herdr jq
    [ -n "$lead" ] || die "usage: flow tick run <lead>"
    herdr agent get "$lead" >/dev/null 2>&1 || exit 0
    config=$(find_config)
    fallback=$(jq -r '.fallback.model // ""' "$config")
    tracker=$(jq -r '.tracker // ""' "$config")
    limits="$(state_dir)/limits"
    ticks="$(state_dir)/ticks"
    mkdir -p "$limits" "$ticks"
    now=$(date +%s)

    at_limit() { herdr agent read "$1" --source visible --lines 200 2>/dev/null | grep -Eiq "$LIMIT"; }
    # stalled_minutes <name>: minutes since the limit was first seen on the session; records the first sighting.
    stalled_minutes() {
      local first
      if [ -f "$limits/$1" ]; then first=$(cat "$limits/$1"); else first=$now; echo "$now" >"$limits/$1"; fi
      echo $(((now - first) / 60))
    }

    # Spawned sessions. One at a usage limit resumes on its own setting once the window resets,
    # which each tick's "continue" catches; one stalled past the cap is the lead's to respawn.
    herdr agent list | jq -r '.result.agents[] | select((.name // "") | startswith("flow-")) | select(.agent_status != "working") | .name' |
      while IFS= read -r run; do
        if at_limit "$run"; then
          minutes=$(stalled_minutes "$run")
          herdr agent prompt "$run" "continue" >/dev/null 2>&1 || true
          if [ "$minutes" -ge "$STALL_MINUTES" ]; then
            record="$(state_dir)/runs/$run.json"
            respawn="flow spawn $(jq -r '"\(.step) \(.target)"' "$record" 2>/dev/null || echo "<step> <target>")"
            respawn="$respawn --model ${fallback:-<fallback model>}"
            effort=$(jq -r '.effort // ""' "$record" 2>/dev/null || true)
            [ -z "$effort" ] || respawn="$respawn --effort $effort"
            cwd=$(jq -r '.cwd // ""' "$record" 2>/dev/null || true)
            [ -z "$cwd" ] || respawn="$respawn --cwd $cwd"
            tell_lead "$lead" "limit: $run stalled $minutes min at a usage limit; respawn it on the fallback model with: $respawn (then flow ledger run its row when the report arrives)" || true
          fi
        else
          rm -f "$limits/$run"
        fi
      done

    # The lead itself. Stalled past the cap, it switches to the fallback model and continues.
    if at_limit "$lead"; then
      minutes=$(stalled_minutes "$lead")
      kind=$(herdr agent get "$lead" | jq -r '.result.agent.agent // ""')
      if [ "$minutes" -ge "$STALL_MINUTES" ] && [ -n "$fallback" ] && [ "$kind" = claude ]; then
        herdr agent prompt "$lead" "/model $fallback" >/dev/null 2>&1 || true
        sleep 3
        # Claude Code confirms a switch that drops its prompt cache; Enter takes the switch.
        if herdr agent read "$lead" --source visible --lines 12 2>/dev/null | grep -q "Switch model?"; then
          herdr agent send-keys "$lead" enter >/dev/null 2>&1 || true
          sleep 3
        fi
        herdr agent prompt "$lead" "continue: this session switched to $fallback after $minutes minutes at a usage limit (flow tick)" >/dev/null 2>&1 || true
      else
        herdr agent prompt "$lead" "continue" >/dev/null 2>&1 || true
      fi
      exit 0
    fi
    rm -f "$limits/$lead"

    # Request issues with a comment since the last tick.
    if [ -n "$tracker" ] && command -v gh >/dev/null 2>&1; then
      since=$(cat "$ticks/$lead.since" 2>/dev/null || jq -n --argjson t "$((now - 1800))" '$t | todate')
      if issues=$(gh issue list -R "$tracker" --label lead:round --state open --limit 50 --json number,title,url,comments 2>&1); then
        jq -r --arg since "$since" '.[] | (.comments | last) as $c | select($c != null and $c.createdAt > $since)
          | "request: \(.url) \"\(.title)\" has a new comment by \($c.author.login) at \($c.createdAt)"' <<<"$issues" |
          while IFS= read -r line; do tell_lead "$lead" "$line" || true; done
        jq -n --argjson t "$now" '$t | todate' >"$ticks/$lead.since"
      else
        echo "flow tick: could not read the request issues of $tracker: $(head -1 <<<"$issues")" >&2
      fi
    fi

    tell_lead "$lead" "lead tick: check runs" || true
    ;;
  *) die "usage: flow tick arm|disarm|run [<lead>]" ;;
esac
