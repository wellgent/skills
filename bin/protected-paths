tsconfig*.json
eslint.config.*
.eslintrc*
.oxlintrc*
biome.json*
.prettierrc*
prettier.config.*
knip.json*
knip.config.*
.knip.json*
.dependency-cruiser.*
vitest.config.*
vitest.workspace.*
jest.config.*
playwright.config.*
