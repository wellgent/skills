#!/usr/bin/env bash
# flow gate <target> [--accept <reason>] [--wait] [--lead <agent>]
# Runs on the branch checked out in the current directory: the project's check command, its
# journey tests and the protected-change script on the whole diff against the main branch, and
# prints the diff class from the project's path lists. The result is JSON, stored for flow land.
# Returns at once; the result reaches the lead's pane as
#   gate: <target> <verdict> <diff class> <result path>
# --wait runs in the foreground and exits 0 pass, 1 red, 2 flagged.
# --accept records the reason against the open flags of the result on HEAD and runs nothing.
# A flag is judged once per target: its identity is kind, file and text, and a flag accepted on
# an earlier commit of the same target is carried, so a later gate is flagged on new flags only.
set -euo pipefail
. "$FLOW_BIN/lib.sh"
need git jq

target= accept= wait= deliver= lead=$(lead_agent)
while [ $# -gt 0 ]; do
  case $1 in
    --accept) accept=${2:?--accept needs a reason}; shift 2 ;;
    --wait) wait=1; shift ;;
    --lead) lead=${2:?--lead needs a herdr agent}; shift 2 ;;
    --deliver) deliver=1; shift ;;
    -*) die "unknown option: $1" ;;
    *) target=$1; shift ;;
  esac
done
[ -n "$target" ] || die "usage: flow gate <target> [--accept <reason>] [--wait] [--lead <agent>]"
parse_target "$target"

git rev-parse --show-toplevel >/dev/null 2>&1 || die "not inside a git repository"
cd "$(git rev-parse --show-toplevel)"
require_clean_tree

main=$(main_branch)
git fetch --quiet origin "$main"
commit=$(git rev-parse HEAD)
tree=$(git rev-parse 'HEAD^{tree}')
branch=$(git rev-parse --abbrev-ref HEAD)
base=$(git merge-base HEAD "origin/$main")
[ "$commit" != "$base" ] || die "HEAD has no commits ahead of origin/$main"

dir=$(gate_dir)
mkdir -p "$dir"
result_file="$dir/$commit.json"
accepted=$(accepted_file "$target")

gate_line() { echo "gate: $target $(jq -r .verdict "$result_file") $(jq -r .diff_class "$result_file") $result_file"; }
exit_for() { case $1 in pass) exit 0 ;; red) exit 1 ;; flagged) exit 2 ;; esac; }

# --accept: the lead judged the open flags of the result on HEAD. Record the reason against each
# one for this target and rewrite the result as passed; the checks were green when it was flagged.
if [ -n "$accept" ]; then
  [ -f "$result_file" ] || die "no gate result on ${commit:0:12}; run flow gate first"
  [ "$(jq -r .target "$result_file")" = "$target" ] || die "the gate result on ${commit:0:12} belongs to $(jq -r .target "$result_file")"
  verdict=$(jq -r .verdict "$result_file")
  [ "$verdict" = flagged ] || die "nothing to accept: the gate on ${commit:0:12} is $verdict"
  stamp=$(jq -n --arg reason "$accept" --arg commit "$commit" --arg time "$(now_utc)" '{reason: $reason, commit: $commit, time: $time}')
  mkdir -p "$(dirname "$accepted")"
  [ -f "$accepted" ] || echo '[]' >"$accepted"
  jq --slurpfile r "$result_file" --argjson stamp "$stamp" \
    '. + [$r[0].flags[] | select(.accepted == null) | {kind, file, text} + $stamp]' "$accepted" >"$accepted.tmp"
  mv "$accepted.tmp" "$accepted"
  jq --argjson stamp "$stamp" '
    .flags |= map(if .accepted == null then .accepted = $stamp else . end)
    | .flags_open = 0 | .flags_accepted = $stamp.reason | .time = $stamp.time | .verdict = "pass"' \
    "$result_file" >"$result_file.tmp"
  mv "$result_file.tmp" "$result_file"
  cat "$result_file"
  echo "flow gate: accepted $(jq --argjson stamp "$stamp" '.flags | map(select(.accepted.commit == $stamp.commit)) | length' "$result_file") flags on ${commit:0:12} for $target" >&2
  gate_line >&2
  exit 0
fi

check=$(dev_loop_values "Check command" | head -1)
journeys=$(dev_loop_values "Journey tests" | head -1)
[ -n "$check" ] || die 'docs/agents/dev-loop.md has no "- **Check command:** `<command>`" line'
# "- **Journeys port:** `<variable>` `<from>-<to>`": the gate exports a free port of that range
# in that variable, so two gates' journey servers never share one.
port_var=$(dev_loop_values "Journeys port" | sed -n 1p)
port_range=$(dev_loop_values "Journeys port" | sed -n 2p)

# Without --wait the checks run detached and the result goes to the lead's pane.
if [ -z "$wait" ]; then
  [ -n "$lead" ] || die "no lead to deliver to: run inside the lead's herdr session, pass --lead <agent>, or --wait"
  need herdr
  detach "$dir/$commit.run.log" "$FLOW_BIN/flow-gate" "$target" --wait --deliver --lead "$lead"
  echo "gate: $target running ${commit:0:12} ($branch); the result arrives in $lead as gate: $target <verdict> <diff class> $result_file"
  exit 0
fi

# One gate at a time per repository: the check and the journeys load the host, and two journey
# runs would reset one deployment under each other. A lock whose holder is gone is taken over.
lock="$(gate_dir)/lock"
waited=0
until mkdir "$lock" 2>/dev/null; do
  holder=$(cat "$lock/holder" 2>/dev/null || echo "unknown unknown 0")
  holder_pid=$(echo "$holder" | awk '{print $3}')
  if [ -n "$holder_pid" ] && ! kill -0 "$holder_pid" 2>/dev/null; then
    rm -rf "$lock"; continue
  fi
  [ "$waited" -gt 0 ] || echo "flow gate: waiting for the gate held by ${holder% *}" >&2
  [ "$waited" -lt 7200 ] || die "the gate lock is held by ${holder% *} for over two hours; remove $lock when that gate is gone"
  sleep 15; waited=$((waited + 15))
done
echo "$target ${commit:0:12} $$ $(now_utc)" >"$lock/holder"
trap 'rm -rf "$lock"' EXIT

if [ -n "$journeys" ] && [ -n "$port_var" ] && [ -z "${!port_var:-}" ]; then
  from=${port_range%-*} to=${port_range#*-}
  for p in $(seq "$from" "$to"); do
    if ! lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then export "$port_var=$p"; break; fi
  done
  [ -n "${!port_var:-}" ] || die "no free port from $from to $to for the journey tests"
  echo "flow gate: journeys on $port_var=${!port_var}" >&2
fi

# The diff class, from the path lists of docs/agents/dev-loop.md.
surface_globs=$(dev_loop_values "Surface paths")
prose_globs=$(dev_loop_values "Prose paths")
n_changed=0 n_prose=0 n_surface=0
while IFS= read -r file; do
  [ -n "$file" ] || continue
  n_changed=$((n_changed + 1))
  if [ -n "$prose_globs" ] && matches_any "$file" "$prose_globs"; then n_prose=$((n_prose + 1)); fi
  if [ -n "$surface_globs" ] && matches_any "$file" "$surface_globs"; then n_surface=$((n_surface + 1)); fi
done < <(git diff --name-only "$base" "$commit")
if [ -n "$prose_globs" ] && [ "$n_prose" -eq "$n_changed" ]; then class=prose-only
elif [ -z "$surface_globs" ] || [ "$n_surface" -gt 0 ]; then class=surface-path
else class=no-surface-path; fi
[ -n "$surface_globs" ] || echo 'flow gate: docs/agents/dev-loop.md has no "- **Surface paths:**" line, so every diff with code counts as surface-path' >&2

# run_step <name> <command>: sets STEP_JSON; the log stays beside the gate result.
run_step() {
  local name=$1 command=$2 log="$dir/$commit.$1.log" start code=0
  echo "flow gate: $name: $command" >&2
  start=$(date +%s)
  bash -c "$command" >"$log" 2>&1 || code=$?
  STEP_JSON=$(jq -n --arg command "$command" --arg log "$log" --argjson exit "$code" \
    --argjson seconds "$(($(date +%s) - start))" '{command: $command, exit: $exit, seconds: $seconds, log: $log}')
  if [ "$code" -ne 0 ]; then
    echo "flow gate: $name failed (exit $code), last lines of $log:" >&2
    tail -n 30 "$log" >&2
  fi
  return 0
}

run_step check "$check"; check_json=$STEP_JSON
journeys_json=null
if [ -n "$journeys" ]; then run_step journeys "$journeys"; journeys_json=$STEP_JSON; fi

[ "$(git rev-parse HEAD)" = "$commit" ] || die "HEAD moved while the checks ran"
[ -z "$(git status --porcelain)" ] || die "the checks changed tracked or unignored files: $(git status --porcelain | head -5)"

# The protected-change flags, with the ones accepted earlier for this target carried.
store='[]'
[ ! -f "$accepted" ] || store=$(cat "$accepted")
flags=$("$FLOW_BIN/flow-protected" "$base" "$commit" | jq --argjson store "$store" '
  map(. as $f
    | ($store | map(select(.kind == $f.kind and .file == $f.file and .text == $f.text)) | last) as $a
    | .accepted = (if $a == null then null else {reason: $a.reason, commit: $a.commit, time: $a.time} end))')

result=$(jq -n --arg target "$target" --arg commit "$commit" --arg tree "$tree" --arg base "$base" \
  --arg branch "$branch" --arg time "$(now_utc)" --arg class "$class" \
  --argjson changed "$n_changed" --argjson prose "$n_prose" --argjson surface "$n_surface" \
  --argjson check "$check_json" --argjson journeys "$journeys_json" --argjson flags "$flags" '
  {target: $target, commit: $commit, tree: $tree, base: $base, branch: $branch, time: $time,
   diff_class: $class, files: {changed: $changed, prose: $prose, surface: $surface},
   check: $check, journeys: $journeys, flags: $flags,
   flags_open: ($flags | map(select(.accepted == null)) | length), flags_accepted: null}
  | .verdict = (
      if .check.exit != 0 or (.journeys != null and .journeys.exit != 0) then "red"
      elif .flags_open > 0 then "flagged"
      else "pass" end)')

echo "$result" >"$result_file"
echo "$result"

verdict=$(jq -r .verdict <<<"$result")
if [ "$(jq length <<<"$flags")" -gt 0 ]; then
  echo "flow gate: $(jq -r '.flags_open' <<<"$result") new protected-change flags, $(jq '.flags | map(select(.accepted != null)) | length' <<<"$result") carried:" >&2
  jq -r '.flags[] | "  \(if .accepted == null then "new" else "carried (" + .accepted.commit[0:12] + ")" end) \(.kind) \(.file):\(.line) \(.text)"' <<<"$result" >&2
fi
echo "flow gate: $verdict, $class, on ${commit:0:12} ($branch)" >&2
[ "$verdict" != flagged ] || echo 'flow gate: judge each new flag, then flow gate --accept "<reason>" or send the target back to Build' >&2
[ -z "$deliver" ] || tell_lead "$lead" "$(gate_line)"
exit_for "$verdict"
